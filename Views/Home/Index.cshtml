@{
    ViewData["Title"] = "Inicio";
}

<style>
    .hero-banner {
        background: linear-gradient(to right, #000000 30%, rgba(0,0,0,0.5) 100%), url('https://m.media-amazon.com/images/M/MV5BN2QyZGU4ZDctOWMzMy00OTA2LWFkNmItMzQxMWE2NTA3ZTA3XkEyXkFqcGdeQXVyMTUzMTg2ODkz._V1_.jpg') no-repeat center center;
        background-size: cover;
        height: 70vh;
        min-height: 500px;
        position: relative;
    }
    .poster-img {
        width: 250px;
        border-radius: 5px;
        box-shadow: 0 0 20px rgba(255,255,255,0.1);
    }
    .btn-rojo {
        background-color: #E50914;
        color: white;
        border: none;
        padding: 10px 30px;
        font-weight: 500;
        transition: 0.3s;
    }
    .btn-rojo:hover { background-color: #b30710; color: white; }
    .btn-outline-blanco {
        background-color: transparent;
        color: white;
        border: 1px solid white;
        padding: 10px 30px;
        font-weight: 500;
        transition: 0.3s;
    }
    .btn-outline-blanco:hover { background-color: rgba(255,255,255,0.1); color: white; }
    
    .carousel-indicators [data-bs-target] {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        margin: 0 6px;
        background-color: transparent;
        border: 1px solid white;
    }
    .carousel-indicators .active { background-color: white; }

    .loop-banner { cursor: pointer; transition: opacity 0.2s; }
    .loop-banner:hover { opacity: 0.7; }
    
    .loop-icon-container {
        width: 45px; height: 45px; border: 2px solid #000; border-radius: 50%;
        display: flex; justify-content: center; align-items: center;
    }
    
    .promo-card { transition: transform 0.3s ease; cursor: pointer; overflow: hidden; }
    .promo-card:hover { transform: scale(1.02); }
    
    .bg-mario-purple { background: linear-gradient(135deg, #4A286F 0%, #764CA3 100%); }
    .bg-mummy-dark { background: linear-gradient(to bottom, rgba(0,0,0,0.2), rgba(0,0,0,0.9)), url('https://images.unsplash.com/photo-1605806616949-1e87b487cb2a?q=80&w=800&auto=format&fit=crop') center/cover; }
</style>

<div id="cinemexCarousel" class="carousel slide" data-bs-ride="carousel">
    <div class="carousel-indicators mb-4">
        <button type="button" data-bs-target="#cinemexCarousel" data-bs-slide-to="0" class="active"></button>
        <button type="button" data-bs-target="#cinemexCarousel" data-bs-slide-to="1"></button>
        <button type="button" data-bs-target="#cinemexCarousel" data-bs-slide-to="2"></button>
        <button type="button" data-bs-target="#cinemexCarousel" data-bs-slide-to="3"></button>
    </div>

    <div class="carousel-inner">
        <div class="carousel-item active">
            <div class="hero-banner d-flex align-items-center">
                <div class="container d-flex align-items-center">
                    <div class="me-5 d-none d-md-block">
                        <img src="https://m.media-amazon.com/images/M/MV5BN2QyZGU4ZDctOWMzMy00OTA2LWFkNmItMzQxMWE2NTA3ZTA3XkEyXkFqcGdeQXVyMTUzMTg2ODkz._V1_.jpg" class="poster-img" alt="Michael Poster">
                    </div>

                    <div class="text-white">
                        <p class="text-uppercase mb-2 fw-bold" style="font-size: 0.8rem; letter-spacing: 1px;">
                            Destacada de la semana <i class="bi bi-star-fill text-warning"></i>
                        </p>
                        <h1 class="display-4 fw-bold text-danger mb-4" style="font-family: 'Impact', sans-serif; text-transform: uppercase;">
                            Michael: La Historia de<br>Michael Jackson
                        </h1>
                        
                        <div class="d-flex gap-3">
                            <a asp-controller="Home" asp-action="ComprarBoletos" class="btn btn-rojo rounded-0 text-decoration-none">Comprar boletos</a>
                            <a href="https://www.youtube.com/watch?v=7wWEvqjsvxE" target="_blank" class="btn btn-outline-blanco rounded-0 text-decoration-none">Ver tráiler</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <button class="carousel-control-prev" type="button" data-bs-target="#cinemexCarousel" data-bs-slide="prev" style="width: 5%;">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#cinemexCarousel" data-bs-slide="next" style="width: 5%;">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
    </button>
</div>

<div class="bg-white text-dark py-4">
    <div class="container">
        <div class="text-center mb-5">
            <p class="mb-0 text-muted" style="cursor: pointer; font-size: 0.9rem;">Ver cartelera <i class="bi bi-arrow-down text-danger"></i></p>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-5 loop-banner">
            <div class="d-flex align-items-center">
                <div class="loop-icon-container me-3">
                    <i class="bi bi-star fs-4 text-dark"></i>
                </div>
                <h2 class="mb-0 fw-bold" style="font-family: 'Impact', sans-serif; letter-spacing: 1px; font-size: 2rem;">INSCRÍBETE A LOOP</h2>
            </div>
            <div>
                <i class="bi bi-arrow-right fs-2 text-dark"></i>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="card bg-mummy-dark text-white border-0 h-100 rounded-0 promo-card" style="min-height: 250px;">
                    <div class="card-img-overlay d-flex flex-column justify-content-end p-4 text-center">
                        <p class="small mb-1 text-uppercase text-light" style="letter-spacing: 1px; font-size: 0.7rem;">Algunas cosas deben permanecer enterradas</p>
                        <h3 class="fw-bold mb-0 text-warning" style="font-family: 'Times New Roman', serif; letter-spacing: 2px;">LA POSESIÓN DE<br>LA MOMIA</h3>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card bg-mario-purple text-white border-0 h-100 rounded-0 promo-card p-3 position-relative" style="min-height: 250px;">
                    <h5 class="fw-bold mb-0" style="font-family: 'Impact', sans-serif;">COMBO<br><span class="fs-3">CUBETA</span></h5>
                    <p class="small mt-2 mb-0 opacity-75" style="font-size: 0.7rem; line-height: 1.2;">1 CUBETA PROMOCIONAL<br>1 PALOMITAS CLÁSICAS GRANDES<br>2 REFRESCOS GRANDES<br>1 CHOCOLATE</p>
                    <div class="position-absolute bottom-0 end-0 p-3">
                        <img src="https://cdn-icons-png.flaticon.com/512/3418/3418066.png" width="100" alt="Palomitas" style="opacity: 0.9;">
                    </div>
                    <div class="position-absolute bottom-0 start-0 p-3">
                         <p class="mb-0 small opacity-75">POR SÓLO</p><h3 class="fw-bold mb-0">$000</h3>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card bg-mario-purple text-white border-0 h-100 rounded-0 promo-card p-3 position-relative" style="min-height: 250px;">
                    <h5 class="fw-bold mb-0" style="font-family: 'Impact', sans-serif;">COMBO SUPER<br><span class="fs-3 text-warning">MARIO GALAXY</span></h5>
                    <p class="small mt-2 mb-0 opacity-75" style="font-size: 0.7rem; line-height: 1.2;">1 CUBETA PROMOCIONAL<br>1 PALOMITAS CLÁSICAS GRANDES<br>1 VASO PROMOCIONAL<br>1 CHOCOLATE</p>
                    <div class="position-absolute bottom-0 end-0 p-3 d-flex align-items-end">
                        <img src="https://cdn-icons-png.flaticon.com/512/911/911409.png" width="40" alt="Vaso" class="me-2" style="opacity: 0.9;">
                        <img src="https://cdn-icons-png.flaticon.com/512/3418/3418066.png" width="80" alt="Palomitas" style="opacity: 0.9;">
                    </div>
                    <div class="position-absolute bottom-0 start-0 p-3">
                         <p class="mb-0 small opacity-75">POR SÓLO</p><h3 class="fw-bold mb-0 text-warning">$000</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>