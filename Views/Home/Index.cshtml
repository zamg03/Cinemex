<style>
    /* Diseño responsivo para mantener el video de fondo adaptado a toda la pantalla (Hero Banner) */
    .video-background-hero { position: relative; width: 100%; height: 75vh; min-height: 550px; overflow: hidden; background-color: #000; }
    .video-background-hero iframe { position: absolute; top: 50%; left: 50%; width: 100vw; height: 100vh; min-width: 177.77vh; min-height: 56.25vw; transform: translate(-50%, -50%); pointer-events: none; }
    .video-overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: linear-gradient(to right, rgba(0,0,0,0.9) 20%, rgba(0,0,0,0.3) 100%); z-index: 1; }
    .hero-content { position: relative; z-index: 2; height: 100%; display: flex; align-items: center; }
    .poster-img { width: 260px; border-radius: 5px; box-shadow: 0 0 30px rgba(255,255,255,0.2); }
    .btn-rojo { background-color: #E50914; color: white; border: none; padding: 12px 35px; font-weight: bold; text-transform: uppercase; font-size: 0.9rem; transition: 0.3s; }
    .btn-rojo:hover { background-color: #b30710; color: white; }
    .cine-title { font-family: 'Impact', sans-serif; letter-spacing: 1px; font-size: 2.5rem; color: #333; }
    .movie-card { border: none; background-color: transparent; transition: transform 0.3s; }
    .movie-card:hover { transform: translateY(-5px); }
    .movie-poster { width: 100%; border-radius: 10px; box-shadow: 0 5px 15px rgba(0,0,0,0.2); margin-bottom: 15px; height: 350px; object-fit: cover; cursor:pointer; }
    .movie-title-dark { color: #333; font-weight: bold; font-size: 0.9rem; }
    .btn-outline-blanco { background-color: transparent; color: #fff; border: 1px solid #fff; padding: 10px 30px; transition: 0.3s; }
    .btn-outline-blanco:hover { background-color: rgba(255,255,255,0.1); color: #fff; }
</style>

<div class="video-background-hero mb-5">
    <iframe src="https://www.youtube.com/embed/7wWEvqjsvxE?autoplay=1&mute=1&loop=1&playlist=7wWEvqjsvxE&controls=0&showinfo=0&rel=0&modestbranding=1&iv_load_policy=3" frameborder="0" allow="autoplay; encrypted-media" allowfullscreen></iframe>
    <div class="video-overlay"></div>
    <div class="container hero-content text-white">
        <div class="d-flex align-items-center w-100">
            <div class="me-5 d-none d-md-block"><img src="/images/posters/michael.jpg" class="poster-img"></div>
            <div>
                <p class="text-uppercase mb-2 fw-bold" style="font-size: 0.8rem; letter-spacing: 1px;">Destacada de la semana <i class="bi bi-star-fill text-warning"></i></p>
                <h1 class="display-3 fw-bold text-danger mb-4 text-uppercase" style="font-family: 'Impact', sans-serif; line-height: 1;">Michael: La Historia de<br>Michael Jackson</h1>
                <div class="d-flex gap-3 mt-4">
                    <button class="btn btn-rojo rounded-0 btn-abrir-panel" 
                            data-pelicula="Michael: La Historia De Michael Jackson" data-poster="/images/posters/michael.jpg" data-sala="Sala 7" data-fechas="HOY,MAÑANA,24 DE ABR." data-horarios="14:00,17:00,20:00" data-trailer="https://www.youtube.com/embed/7wWEvqjsvxE" data-preventa="false" data-original="Michael" data-clasif="A" data-genero="Biografía, Musical" data-director="Antoine Fuqua" data-actores="Jaafar Jackson, Colman Domingo, Miles Teller" data-pais="Estados Unidos" data-duracion="2h 5m" data-dist="Universal Pictures">Comprar boletos</button>
                    <a href="https://www.youtube.com/watch?v=7wWEvqjsvxE" target="_blank" class="btn btn-outline-blanco rounded-0">Ver tráiler completo</a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container pb-5">
    <h2 class="cine-title mb-4 border-bottom border-secondary pb-2 text-uppercase">En cartelera</h2>
    <div class="row g-4 mb-5">
        @foreach(var p in carteleraNormal) {
            <div class="col-md-2 col-6">
                <div class="movie-card text-center">
                    <img src="@p["Poster"]" class="movie-poster btn-abrir-panel" 
                         data-pelicula="@p["Titulo"]" data-poster="@p["Poster"]" data-sala="@p["Sala"]" data-fechas="@p["Fechas"]" data-horarios="@p["Horarios"]" data-trailer="@p["Trailer"]" data-preventa="@p["EsPreventa"]" data-original="@p["Original"]" data-clasif="@p["Clasificacion"]" data-genero="@p["Genero"]" data-director="@p["Director"]" data-actores="@p["Actores"]" data-pais="@p["Pais"]" data-duracion="@p["Duracion"]" data-dist="@p["Distribuidor"]">
                    <h6 class="movie-title-dark text-truncate mb-3" title="@p["Titulo"]">@p["Titulo"]</h6>
                    <button class="btn btn-rojo w-100 rounded-0 py-1 btn-abrir-panel" 
                            data-pelicula="@p["Titulo"]" data-poster="@p["Poster"]" data-sala="@p["Sala"]" data-fechas="@p["Fechas"]" data-horarios="@p["Horarios"]" data-trailer="@p["Trailer"]" data-preventa="@p["EsPreventa"]" data-original="@p["Original"]" data-clasif="@p["Clasificacion"]" data-genero="@p["Genero"]" data-director="@p["Director"]" data-actores="@p["Actores"]" data-pais="@p["Pais"]" data-duracion="@p["Duracion"]" data-dist="@p["Distribuidor"]">Boletos</button>
                </div>
            </div>
        }
    </div>

    <h2 class="cine-title mb-4 border-bottom border-secondary pb-2 text-uppercase">Preventas <i class="bi bi-ticket-perforated text-danger"></i></h2>
    <div class="row g-4 mb-5">
        @foreach(var p in preventas) {
            <div class="col-md-2 col-6">
                <div class="movie-card text-center">
                    <img src="@p["Poster"]" class="movie-poster btn-abrir-panel" 
                         data-pelicula="@p["Titulo"]" data-poster="@p["Poster"]" data-sala="@p["Sala"]" data-fechas="@p["Fechas"]" data-horarios="@p["Horarios"]" data-trailer="@p["Trailer"]" data-preventa="@p["EsPreventa"]" data-original="@p["Original"]" data-clasif="@p["Clasificacion"]" data-genero="@p["Genero"]" data-director="@p["Director"]" data-actores="@p["Actores"]" data-pais="@p["Pais"]" data-duracion="@p["Duracion"]" data-dist="@p["Distribuidor"]">
