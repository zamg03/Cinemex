@{
    ViewData["Title"] = "Horarios y Boletos";
}

<style>
    .movie-header { background-color: #1a1a1a; padding: 40px 0; border-bottom: 4px solid #E50914; }
    .movie-poster-small { width: 180px; border-radius: 8px; box-shadow: 0 4px 15px rgba(0,0,0,0.5); }
    .time-btn { border: 1px solid #ccc; color: #333; background: white; padding: 8px 25px; border-radius: 4px; margin-right: 12px; text-decoration: none; font-weight: 500; transition: 0.2s; display: inline-block; }
    .time-btn:hover { background: #E50914; color: white; border-color: #E50914; }
    .cine-title { font-family: 'Impact', sans-serif; letter-spacing: 1px; }
    .select-cine { border: 2px solid #E50914; font-weight: bold; color: #333; cursor: pointer; }
    .select-cine:focus { box-shadow: 0 0 0 0.25rem rgba(229, 9, 20, 0.25); border-color: #E50914; }
</style>

<div class="movie-header text-white">
    <div class="container d-flex align-items-center flex-wrap">
        <img src="https://m.media-amazon.com/images/M/MV5BN2QyZGU4ZDctOWMzMy00OTA2LWFkNmItMzQxMWE2NTA3ZTA3XkEyXkFqcGdeQXVyMTUzMTg2ODkz._V1_.jpg" class="movie-poster-small me-4 mb-3" alt="Poster">
        <div>
            <h2 class="fw-bold text-uppercase" style="font-family: 'Impact', sans-serif; letter-spacing: 1px;">Michael: La Historia de Michael Jackson</h2>
            <p class="text-muted mb-2">Clasificación: B15 | Duración: 120 min | Género: Biopic, Musical</p>
        </div>
    </div>
</div>

<div class="bg-white text-dark py-5" style="min-height: 50vh;">
    <div class="container">
        <h3 class="cine-title mb-4 border-bottom pb-2">SELECCIONA TU CINE Y HORARIO</h3>
        
        <div class="mb-4">
            <select id="cineSelector" class="form-select form-select-lg select-cine w-auto">
                <option value="Céntrika">Cinemex Céntrika</option>
                <option value="Garza Sada">Cinemex Garza Sada</option>
                <option value="Lincoln">Cinemex Lincoln</option>
                <option value="Mol Concordia" selected>Cinemex Mol Concordia</option>
                <option value="Pabellón M">Cinemex Pabellón M</option>
            </select>
        </div>
        
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-4">
                <h4 class="fw-bold mb-4 text-danger"><i class="bi bi-geo-alt-fill me-2"></i><span id="cineNameDisplay">Cinemex Mol Concordia</span></h4>
                
                <div class="mb-4 border-start border-3 border-danger ps-3">
                    <h6 class="fw-bold text-muted mb-3">TRADICIONAL 2D ESPAÑOL</h6>
                    <div class="d-flex flex-wrap">
                        <a href="#" data-horario="14:30" class="time-btn mb-2">14:30</a>
                        <a href="#" data-horario="17:00" class="time-btn mb-2">17:00</a>
                        <a href="#" data-horario="19:45" class="time-btn mb-2">19:45</a>
                        <a href="#" data-horario="22:15" class="time-btn mb-2">22:15</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    const cineSelector = document.getElementById('cineSelector');
    const cineNameDisplay = document.getElementById('cineNameDisplay');
    const timeBtns = document.querySelectorAll('.time-btn');

    function updateLinks() {
        const selectedCine = cineSelector.value;
        cineNameDisplay.innerText = 'Cinemex ' + selectedCine;
        
        timeBtns.forEach(btn => {
            const horario = btn.getAttribute('data-horario');
            btn.href = `/Home/Asientos?horario=${horario}&cine=${encodeURIComponent(selectedCine)}`;
        });
    }

    cineSelector.addEventListener('change', updateLinks);
    updateLinks(); // Inicializar al cargar la página
</script>