@{
    ViewData["Title"] = "Medio de Pago";
}

<style>
    .bg-light-gray { background-color: #fcfcfc; }
    .cine-title { font-family: 'Impact', sans-serif; letter-spacing: 1px; font-size: 2.5rem; text-transform: uppercase; }
    .payment-box { border: 1px solid #ccc; padding: 20px; margin-bottom: 15px; background: white; cursor: pointer; transition: 0.2s; }
    .payment-box:hover { border-color: #000; }
    .summary-panel { border-left: 1px solid #eee; padding-left: 40px; }
    .poster-mini { width: 120px; height: 180px; object-fit: cover; box-shadow: 0 4px 10px rgba(0,0,0,0.2); }
    .text-danger-cine { color: #E50914; }
    .input-cine { border: 0; border-bottom: 1px solid #ccc; border-radius: 0; padding-left: 0; background: transparent; }
    .input-cine:focus { box-shadow: none; border-color: #000; }
    .btn-pagar { background-color: #E50914; color: white; font-weight: bold; border: none; padding: 12px; }
    .btn-pagar:hover { background-color: #b30710; color: white; }
</style>

<div class="bg-light-gray py-4 text-dark" style="min-height: 80vh;">
    <div class="container">
        <div class="row">
            <div class="col-lg-7 pe-lg-5 pt-3">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <a href="javascript:history.back()" class="text-dark fs-4"><i class="bi bi-arrow-left"></i></a>
                    <span class="text-danger-cine fs-5"><span id="timer">05:00</span> <i class="bi bi-stopwatch"></i></span>
                </div>
                
                <h1 class="cine-title mb-5">MEDIO DE PAGO</h1>

                <div class="payment-box d-flex justify-content-between align-items-center" id="boxTarjeta">
                    <span class="fs-5">Tarjeta de pago</span>
                    <i class="bi bi-credit-card-2-front text-primary fs-3"></i>
                </div>

                <div id="formTarjeta" class="p-4 border border-top-0 bg-white mb-4" style="display:block;">
                    <form id="paymentForm" method="post" action="/Home/Confirmacion">
                        <input type="hidden" name="pelicula" value="@ViewBag.Pelicula" />
                        <input type="hidden" name="poster" value="@ViewBag.Poster" />
                        <input type="hidden" name="fecha" value="@ViewBag.Fecha" />
                        <input type="hidden" name="sala" value="@ViewBag.Sala" />
                        <input type="hidden" name="horario" value="@ViewBag.Horario" />
                        <input type="hidden" name="cine" value="@ViewBag.Cine" />
                        <input type="hidden" name="asientos" value="@ViewBag.Asientos" />
                        <input type="hidden" name="cantidadAsientos" value="@ViewBag.Cantidad" />
                        <input type="hidden" name="totalPagar" value="@ViewBag.Total" />

                        <div class="mb-4">
                            <input type="text" class="form-control input-cine" id="ccName" placeholder="Nombre en la tarjeta" required>
                            <small class="text-danger d-none" id="errName">Solo se permiten letras.</small>
                        </div>
                        <div class="mb-4">
                            <input type="text" class="form-control input-cine" id="ccNumber" placeholder="Número de tarjeta (16 dígitos)" maxlength="16" required>
                            <small class="text-danger d-none" id="errNumber">Debe contener exactamente 16 números.</small>
                        </div>
                        <div class="row mb-4">
                            <div class="col-6">
                                <input type="text" class="form-control input-cine" id="ccExp" placeholder="Mes / Año (MM/AA)" maxlength="5" required>
                                <small class="text-danger d-none" id="errExp">Fecha inválida o expirada.</small>
                            </div>
                            <div class="col-6">
                                <input type="password" class="form-control input-cine" id="ccCvv" placeholder="CVV" maxlength="4" required>
                                <small class="text-danger d-none" id="errCvv">Debe ser de 3 o 4 números.</small>
                            </div>
                        </div>

                        <div class="form-check mt-4 mb-4">
                            <input class="form-check-input" type="checkbox" id="termsCheck" required>
                            <label class="form-check-label small" for="termsCheck">Acepto los <a href="#" class="text-danger-cine text-decoration-none">Términos y Condiciones</a> y el <a href="#" class="text-danger-cine text-decoration-none">Aviso de Privacidad</a></label>
                        </div>
                        
                        <p class="small text-muted mb-4">Los boletos son válidos únicamente para el día y horario seleccionado. No se realizarán reembolsos ni cambios de horarios una vez realizada la compra.</p>

                        <button type="submit" class="btn btn-pagar w-100 rounded-0" id="btnSubmit">REALIZAR PAGO</button>
                    </form>
                </div>

                <div class="payment-box d-flex justify-content-between align-items-center text-muted">
                    <span class="fs-5">PayPal</span>
                    <i class="bi bi-paypal text-primary fs-3"></i>
                </div>
            </div>

            <div class="col-lg-5 summary-panel pt-3 d-none d-lg-block">
                <div class="d-flex justify-content-between mb-4 border-bottom pb-2">
                    <span class="fw-bold"><i class="bi bi-credit-card-2-front text-danger"></i> ¿Eres miembro Cinemex Loop?</span>
                    <i class="bi bi-chevron-down"></i>
                </div>

                <div class="d-flex mb-5">
                    <img src="@ViewBag.Poster" class="poster-mini me-4">
                    <div>
                        <h3 class="fw-bold text-uppercase" style="font-family: 'Impact', sans-serif; line-height: 1.1;">@ViewBag.Pelicula</h3>
                        <p class="mb-1 mt-2 text-muted">Cinemex @ViewBag.Cine</p>
                        <p class="mb-1 text-muted">@ViewBag.Fecha, @ViewBag.Horario hrs</p>
                        <p class="mb-1 text-muted">@ViewBag.Sala</p>
                        <p class="mb-1 text-muted">Español Tradicional</p>
                    </div>
                </div>

                <div class="border-bottom pb-3 mb-4">
                    <div class="row mb-2">
                        <div class="col-5 text-muted small">BOLETOS</div>
                        <div class="col-7">@ViewBag.Cantidad ADULTO</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-5 text-muted small">ASIENTOS</div>
                        <div class="col-7">@ViewBag.Asientos</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-5 text-muted small">COSTO POR SERVICIO</div>
                        <div class="col-7">$16.00</div>
                    </div>
                </div>

                <div class="row align-items-center mb-2">
                    <div class="col-5 text-muted">TOTAL A PAGAR</div>
                    <div class="col-7 text-danger-cine fs-4 fw-bold">@ViewBag.Total</div>
                </div>
                <p class="small text-muted" style="font-size: 0.75rem;">Esta transacción tendrá un costo por servicio según los boletos seleccionados.</p>
            </div>
        </div>
    </div>
</div>

<script>
    let time = 300; 
    setInterval(() => {
        let m = Math.floor(time / 60);
        let s = time % 60;
        document.getElementById('timer').innerText = `0${m}:${s < 10 ? '0' : ''}${s}`;
        if(time > 0) time--;
    }, 1000);

    document.getElementById('ccExp').addEventListener('input', function (e) {
        let val = e.target.value.replace(/\D/g, '');
        if (val.length > 2) val = val.substring(0, 2) + '/' + val.substring(2, 4);
        e.target.value = val;
    });

    document.getElementById('paymentForm').addEventListener('submit', function(e) {
        let isValid = true;
        const name = document.getElementById('ccName').value;
        const regexName = /^[a-zA-Z\sñÑáéíóúÁÉÍÓÚ]+$/;
        if(!regexName.test(name)) { document.getElementById('errName').classList.remove('d-none'); isValid = false; } 
        else { document.getElementById('errName').classList.add('d-none'); }

        const number = document.getElementById('ccNumber').value;
        const regexNum = /^\d{16}$/;
        if(!regexNum.test(number)) { document.getElementById('errNumber').classList.remove('d-none'); isValid = false; } 
        else { document.getElementById('errNumber').classList.add('d-none'); }

        const exp = document.getElementById('ccExp').value;
        let expValid = false;
        if(exp.length === 5) {
            const parts = exp.split('/');
            const month = parseInt(parts[0], 10);
            const year = parseInt('20' + parts[1], 10);
            const now = new Date();
            const currentMonth = now.getMonth() + 1;
            const currentYear = now.getFullYear();
            if (month >= 1 && month <= 12 && (year > currentYear || (year === currentYear && month >= currentMonth))) { expValid = true; }
        }
        if(!expValid) { document.getElementById('errExp').classList.remove('d-none'); isValid = false; } 
        else { document.getElementById('errExp').classList.add('d-none'); }

        const cvv = document.getElementById('ccCvv').value;
        const regexCvv = /^\d{3,4}$/;
        if(!regexCvv.test(cvv)) { document.getElementById('errCvv').classList.remove('d-none'); isValid = false; } 
        else { document.getElementById('errCvv').classList.add('d-none'); }

        if(!isValid) { e.preventDefault(); }
    });
</script>