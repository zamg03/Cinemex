@model Cinemex.Models.Usuario
@{
    ViewData["Title"] = "Registro";
    Layout = null; 
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Registro - Cinemex</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        body, html { height: 100%; margin: 0; font-family: Arial, sans-serif; overflow-x: hidden; }
        .left-panel { background-color: #E50914; color: white; display: flex; flex-direction: column; justify-content: center; padding: 4rem 10%; position: relative; }
        .title-loop { font-family: 'Impact', sans-serif; font-size: 4rem; line-height: 1; letter-spacing: 1px; text-transform: uppercase; margin-bottom: 2rem; }
        .list-icon { font-size: 1.3rem; margin-right: 15px; }
        .list-item { display: flex; align-items: flex-start; margin-bottom: 1.2rem; font-size: 1.05rem; }
        .right-panel { background-color: #fff; color: #333; display: flex; flex-direction: column; justify-content: flex-start; padding: 2rem 10% 4rem 10%; position: relative; height: 100vh; overflow-y: auto; scroll-behavior: smooth; }
        .btn-close-custom { position: absolute; top: 20px; right: 30px; font-size: 1.5rem; color: #333; text-decoration: none; transition: 0.3s; z-index: 10;}
        .btn-close-custom:hover { color: #E50914; }
        .back-arrow { font-size: 1.5rem; color: #333; text-decoration: none; transition: 0.3s; display: inline-block; margin-bottom: 15px; margin-top: 10px; }
        .back-arrow:hover { color: #E50914; }
        .main-title { font-family: 'Impact', sans-serif; font-size: 3rem; line-height: 1; text-transform: uppercase; margin-bottom: 30px; letter-spacing: 1px;}
        .icon-envelope { font-size: 2.5rem; color: #b7b7b7; text-align: center; display: block; margin-bottom: 5px; }
        .input-line { width: 100%; border: none; border-bottom: 1px solid #ccc; padding: 12px 0; font-size: 1rem; color: #000; background: transparent; outline: none; transition: 0.3s; margin-bottom: 25px; }
        .input-line:focus { border-bottom: 2px solid #E50914; }
        .input-line::placeholder { color: #888; font-weight: normal; }
        .input-readonly { border-bottom: 1px solid #000; padding: 0 0 10px 0; font-size: 1rem; margin-bottom: 25px; pointer-events: none; }
        .btn-gris { background-color: #f1f1f1; color: #333; border: none; padding: 12px; font-weight: bold; font-size: 1rem; transition: 0.3s; width: 100%; margin-top: 10px; border-radius: 3px; }
        .btn-gris:hover { background-color: #e2e2e2; }
        .btn-rojo { background-color: #E50914; color: white; border: none; padding: 15px; font-weight: bold; font-size: 1.1rem; transition: 0.3s; width: 100%; margin-top: 10px; border-radius: 3px; }
        .btn-rojo:hover { background-color: #b30710; color: white; }
        .step-container { display: none; }
        .step-container.active { display: block; animation: fadeIn 0.4s; }
        @@keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
        .label-email { font-size: 0.8rem; font-weight: bold; margin-bottom: 2px; display: block; }
        .label-email span { color: #E50914; }
    </style>
</head>
<body>
    <div class="row h-100 g-0">
        <div class="col-md-6 left-panel d-none d-md-flex">
            <h1 class="title-loop">¿SABES QUÉ ES CINEMEX LOOP?</h1>
            <p class="fs-5 mb-4"><strong>El mejor programa de recompensas</strong> que premia tu diversión.</p>
            <p class="fs-5 mb-5">Regístrate aquí y empieza a disfrutar la experiencia de ser miembro Cinemex Loop.</p>
            <div class="list-item"><i class="bi bi-123 list-icon"></i> <span>Acumula puntos en cada una de tus compras.</span></div>
            <div class="list-item"><i class="bi bi-ticket-perforated list-icon"></i> <span>Canjea tus puntos por boletos en la taquilla y productos en dulcería.</span></div>
            <div class="list-item"><i class="bi bi-people list-icon"></i> <span>Todos los martes 2x1.</span></div>
            <div class="list-item"><i class="bi bi-bucket list-icon"></i> <span>Combo Lunes y Jueves a precio preferencial.</span></div>
            <div class="list-item"><i class="bi bi-gift list-icon"></i> <span>Recibe regalos en el mes de tu cumpleaños.</span></div>
            <div class="list-item"><i class="bi bi-cup-straw list-icon"></i> <span>Refill de palomitas y/o refresco a precio especial.</span></div>
            <div class="list-item"><i class="bi bi-percent list-icon"></i> <span>Promociones todos los días.</span></div>
        </div>

        <div class="col-md-6 right-panel" id="rightPanel">
            <a asp-controller="Home" asp-action="Index" class="btn-close-custom"><i class="bi bi-x-lg"></i></a>

            <div class="w-100" style="max-width: 400px; margin: 0 auto;">
                <a asp-controller="Account" asp-action="Login" class="back-arrow"><i class="bi bi-arrow-left"></i></a>
                <h2 class="main-title">COMPLETA TU<br>REGISTRO</h2>

                @if (ViewBag.Error != null)
                {
                    <div id="errorBox" class="p-3 mb-4" style="background-color: #f8d7da; color: #721c24; font-weight: bold; font-size: 0.9rem; border-radius: 5px;">
                        <div class="mb-1"><i class="bi bi-x-circle-fill me-2 text-danger"></i>@Html.Raw(ViewBag.Error)</div>
                    </div>
                }
                else
                {
                    <div id="errorBox" class="p-3 mb-4 d-none" style="background-color: #f8d7da; color: #721c24; font-weight: bold; font-size: 0.9rem; border-radius: 5px;"></div>
                }

                <div id="paso1" class="step-container">
                    <div class="text-center mb-4 mt-2">
                        <i class="bi bi-envelope icon-envelope"></i>
                        <p class="text-dark mb-0" style="font-size: 1rem;">Por favor escribe tu correo electrónico.</p>
                    </div>

                    <input type="email" id="emailInputStep1" class="input-line" placeholder="ejemplo@gmail.com" value="@Model?.Email" required autofocus>

                    <button type="button" class="btn-gris" id="btnValidarCorreo" onclick="validarPaso1()">Validar correo</button>

                    <div class="text-center mt-5">
                         <p class="mb-0"><span class="text-muted small">¿Ya tienes cuenta?</span> <a asp-controller="Account" asp-action="Login" class="text-danger ms-1 text-decoration-none small">Inicia sesión aquí.</a></p>
                    </div>
                </div>

                <div id="paso1_5" class="step-container">
                    <div class="text-center mb-4 mt-2">
                        <i class="bi bi-shield-lock icon-envelope text-danger"></i>
                        <p class="text-dark mb-0 fw-bold" style="font-size: 1.1rem;">Verifica tu correo</p>
                        <p class="text-muted small mt-2">Hemos enviado un código de 6 dígitos a <strong id="lblCorreoEnviado"></strong>. Ingresa el código abajo para continuar.</p>
                    </div>

                    <input type="text" id="codigoInput" class="input-line text-center fs-4 fw-bold text-danger" placeholder="------" maxlength="6" style="letter-spacing: 5px;">

                    <button type="button" class="btn-rojo" onclick="verificarCodigo()">Confirmar código</button>
                    <button type="button" class="btn-gris" onclick="reiniciarPaso1()">Usar otro correo</button>
                </div>

                <div id="paso2" class="step-container">
                    <form id="registroForm" asp-action="Register" method="post" onsubmit="return validarPaso2(event)">
                        
                        <label class="label-email mt-2">Email<span>*</span></label>
                        <input type="email" id="emailInputStep2" name="Email" class="input-line input-readonly mt-0" value="@Model?.Email" readonly>

                        <input type="text" class="input-line" name="Nombres" placeholder="Nombres" value="@Model?.Nombres" required>
                        <input type="text" class="input-line" name="ApellidoPaterno" placeholder="Apellido paterno" value="@Model?.ApellidoPaterno" required>
                        <input type="text" class="input-line" name="ApellidoMaterno" placeholder="Apellido materno" value="@Model?.ApellidoMaterno">
                        <input type="tel" class="input-line" name="Telefono" placeholder="Teléfono" maxlength="10" value="@Model?.Telefono" required>
                        
                        <input type="text" class="input-line text-muted" name="FechaNacimiento" placeholder="Fecha de nacimiento" onfocus="(this.type='date')" onblur="(this.type='text')" value="@Model?.FechaNacimiento" required>

                        <div class="position-relative mt-2">
                            <input type="password" id="passwordInput" class="input-line pe-5" name="Password" placeholder="Contraseña" required>
                            <i class="bi bi-eye-slash position-absolute" style="right: 10px; top: 12px; cursor: pointer; color: #888;" id="togglePass"></i>
                        </div>

                        <button type="submit" class="btn-rojo">CREAR CUENTA</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    
    <script>
        let hasError = false;
    </script>
    @if (ViewBag.Error != null)
    {
        <script>
            hasError = true;
        </script>
    }

    <script>
        let codigoServidor = "";

        document.addEventListener("DOMContentLoaded", () => {
            if (hasError) {
                document.getElementById('paso1').classList.remove('active');
                document.getElementById('paso2').classList.add('active');
                setTimeout(() => { document.getElementById('rightPanel').scrollTo({ top: 0, behavior: 'smooth' }); }, 100);
            } else {
                document.getElementById('paso1').classList.add('active');
            }
        });

        document.getElementById('togglePass').addEventListener('click', function (e) {
            const passInput = document.getElementById('passwordInput');
            if (passInput.type === 'password') {
                passInput.type = 'text';
                this.classList.remove('bi-eye-slash');
                this.classList.add('bi-eye');
            } else {
                passInput.type = 'password';
                this.classList.remove('bi-eye');
                this.classList.add('bi-eye-slash');
            }
        });

        document.getElementById('emailInputStep1').addEventListener('input', function(e) {
            const val = e.target.value;
            const regexRepetidas = /(.)\1{14,}/; 
            
            if(regexRepetidas.test(val)) {
                e.target.value = ""; 
                mostrarError("No puedes repetir la misma letra tantas veces.");
            }
        });

        function mostrarError(mensaje) {
            const errorBox = document.getElementById('errorBox');
            errorBox.innerHTML = `<div class="mb-1"><i class="bi bi-x-circle-fill me-2 text-danger"></i>${mensaje}</div>`;
            errorBox.classList.remove('d-none');
            document.getElementById('rightPanel').scrollTo({ top: 0, behavior: 'smooth' });
        }

        function ocultarError() {
            document.getElementById('errorBox').classList.add('d-none');
        }

        function validarPaso1() {
            const emailInput = document.getElementById('emailInputStep1');
            const email = emailInput.value.trim().toLowerCase();
            
            if (!emailInput.checkValidity() || email === '') {
                mostrarError("Ingresa un formato de correo electrónico válido.");
                return;
            }

            const dominiosPermitidos = ['gmail.com', 'hotmail.com', 'yahoo.com', 'outlook.com', 'live.com'];
            const partes = email.split(String.fromCharCode(64)); 
            
            if(partes.length === 2) {
                const dominio = partes[1];
                if(!dominiosPermitidos.includes(dominio)) {
                    mostrarError(`El correo debe ser de uno de estos proveedores: ${dominiosPermitidos.join(', ')}.`);
                    return;
                }
            }

            ocultarError();
            
            const btn = document.getElementById('btnValidarCorreo');
            btn.innerText = "Enviando código...";
            btn.disabled = true;

            fetch('/Account/EnviarCodigoConfirmacion?correo=' + encodeURIComponent(email), { method: 'POST' })
            .then(response => response.json())
            .then(data => {
                btn.innerText = "Validar correo";
                btn.disabled = false;

                if(data.exito) {
                    codigoServidor = data.codigoEnviado;
                    document.getElementById('lblCorreoEnviado').innerText = email;
                    
                    document.getElementById('paso1').classList.remove('active');
                    document.getElementById('paso1_5').classList.add('active');
                } else {
                    mostrarError(data.error);
                }
            })
            .catch(err => {
                btn.innerText = "Validar correo";
                btn.disabled = false;
                mostrarError("Hubo un error de red al intentar enviar el correo.");
            });
        }

        function verificarCodigo() {
            const codigoTecleado = document.getElementById('codigoInput').value.trim();
            
            if(codigoTecleado === codigoServidor) {
                ocultarError();
                const emailAprobado = document.getElementById('emailInputStep1').value.trim();
                document.getElementById('emailInputStep2').value = emailAprobado;
                
                document.getElementById('paso1_5').classList.remove('active');
                document.getElementById('paso2').classList.add('active');
            } else {
                mostrarError("El código ingresado es incorrecto. Intenta de nuevo.");
            }
        }

        function reiniciarPaso1() {
            ocultarError();
            document.getElementById('codigoInput').value = "";
            document.getElementById('paso1_5').classList.remove('active');
            document.getElementById('paso1').classList.add('active');
        }

        function validarPaso2(event) {
            const password = document.getElementById('passwordInput').value;
            let errores = [];

            if (password.length < 8) errores.push("Tiene que contener mínimo 8 caracteres.");
            if (password.length > 20) errores.push("Límite máximo de 20 caracteres.");
            if (password.indexOf(' ') >= 0) errores.push("No debe contener espacios.");
            if (!/[A-Z]/.test(password)) errores.push("Falta mayúscula.");
            if (!/[a-z]/.test(password)) errores.push("Tiene que contener al menos una minúscula.");
            if (!/\d/.test(password)) errores.push("Falta número.");
            if (!/[^a-zA-Z0-9\s]/.test(password)) errores.push("Tiene que contener al menos un símbolo.");

            if (errores.length > 0) {
                event.preventDefault(); 
                let htmlErrores = "";
                errores.forEach(err => { htmlErrores += `<div class="mb-1"><i class="bi bi-x-circle-fill me-2 text-danger"></i>${err}</div>`; });
                
                const errorBox = document.getElementById('errorBox');
                errorBox.innerHTML = htmlErrores;
                errorBox.classList.remove('d-none');
                document.getElementById('rightPanel').scrollTo({ top: 0, behavior: 'smooth' });
                return false;
            }
            ocultarError();
            return true; 
        }
    </script>
</body>
</html>