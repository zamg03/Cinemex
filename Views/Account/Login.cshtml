@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = null; 
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar Sesión - Cinemex</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        body, html { height: 100%; margin: 0; font-family: Arial, sans-serif; overflow-x: hidden; }
        .left-panel { background-color: #E50914; color: white; display: flex; flex-direction: column; justify-content: center; padding: 4rem 10%; position: relative; }
        .title-loop { font-family: 'Impact', sans-serif; font-size: 4rem; line-height: 1; letter-spacing: 1px; text-transform: uppercase; margin-bottom: 2rem; }
        .list-icon { font-size: 1.3rem; margin-right: 15px; }
        .list-item { display: flex; align-items: flex-start; margin-bottom: 1.2rem; font-size: 1.05rem; }
        .right-panel { background-color: #fff; color: #333; display: flex; flex-direction: column; justify-content: center; padding: 4rem 10%; position: relative; }
        .btn-close-custom { position: absolute; top: 20px; right: 30px; font-size: 1.5rem; color: #333; text-decoration: none; transition: 0.3s; }
        .btn-close-custom:hover { color: #E50914; }
        .title-hola { font-family: 'Impact', sans-serif; font-size: 3rem; text-align: center; text-transform: uppercase; margin-bottom: 10px; }
        .subtitle-hola { text-align: center; color: #555; margin-bottom: 40px; }
        .input-line { width: 100%; border: none; border-bottom: 1px solid #ccc; padding: 12px 0; font-size: 1rem; color: #000; background: transparent; outline: none; transition: 0.3s; margin-bottom: 25px; }
        .input-line:focus { border-bottom: 2px solid #E50914; }
        .input-line::placeholder { color: #888; font-weight: normal; }
        .btn-ingresar { background-color: #f1f1f1; color: #333; border: none; padding: 12px; font-weight: bold; font-size: 1rem; transition: 0.3s; width: 100%; margin-top: 10px; }
        .btn-ingresar:hover { background-color: #e2e2e2; }
        .link-olvido { display: block; text-align: center; color: #555; text-decoration: none; font-size: 0.9rem; margin-top: 20px; transition: 0.3s; }
        .link-olvido:hover { color: #E50914; }
        .btn-social { padding: 12px; font-weight: bold; font-size: 1.2rem; width: 100%; display: flex; justify-content: center; align-items: center; border: 1px solid #ccc; background: white; color: #333; transition: 0.3s; }
        .btn-social.facebook { background-color: #3b5998; color: white; border: none; }
        .btn-social.facebook:hover { background-color: #2d4373; }
        .btn-social.apple:hover { background-color: #f1f1f1; }
    </style>
</head>
<body>

    <div class="row h-100 g-0">
        <div class="col-md-6 left-panel d-none d-md-flex">
            <h1 class="title-loop">¿SABES QUÉ ES CINEMEX LOOP?</h1>
            <p class="fs-5 mb-4"><strong>El mejor programa de recompensas</strong> que premia tu diversión.</p>
            <p class="fs-5 mb-5">Regístrate aquí y empieza a disfrutar la experiencia de ser miembro Cinemex Loop.</p>

            <div class="list-item"><i class="bi bi-123 list-icon"></i> <span>Acumula puntos en cada una de tus compras.</span></div>
            <div class="list-item"><i class="bi bi-ticket-perforated list-icon"></i> <span>Canjea tus puntos por boletos en la taquilla y productos en dulcería.</span></div>
            <div class="list-item"><i class="bi bi-people list-icon"></i> <span>Todos los martes 2x1.</span></div>
            <div class="list-item"><i class="bi bi-bucket list-icon"></i> <span>Combo Lunes y Jueves a precio preferencial.</span></div>
            <div class="list-item"><i class="bi bi-gift list-icon"></i> <span>Recibe regalos en el mes de tu cumpleaños.</span></div>
            <div class="list-item"><i class="bi bi-cup-straw list-icon"></i> <span>Recarga de palomitas y/o refresco a precio especial.</span></div>
            <div class="list-item"><i class="bi bi-percent list-icon"></i> <span>Promociones todos los días.</span></div>
        </div>

        <div class="col-md-6 right-panel">
            <a asp-controller="Home" asp-action="Index" class="btn-close-custom"><i class="bi bi-x-lg"></i></a>

            <div class="w-100" style="max-width: 400px; margin: 0 auto;">
                <h2 class="title-hola">¡HOLAAAA!</h2>
                <p class="subtitle-hola">Ingresa con tu usuario y contraseña.</p>

                <div id="errorBox" class="alert alert-danger border-0 rounded-0 small fw-bold text-center p-2 mb-4 @(ViewBag.Error == null ? "d-none" : "")" style="background-color: #f8d7da; color: #721c24;">
                    @if (ViewBag.Error != null)
                    {
                        <i class="bi bi-x-circle-fill me-2 text-danger"></i>@Html.Raw(ViewBag.Error)
                    }
                </div>

                <form asp-action="Login" method="post">
                    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                    
                    <input type="email" id="emailInput" class="input-line" name="email" placeholder="Correo electrónico" required autofocus>
                    
                    <div class="position-relative">
                        <input type="password" class="input-line pe-5" name="password" id="passInput" placeholder="Contraseña" required>
                        <i class="bi bi-eye-slash position-absolute" style="right: 10px; top: 12px; cursor: pointer; color: #888;" id="togglePass"></i>
                    </div>

                    <button type="submit" class="btn-ingresar">Ingresar</button>
                    
                    <a href="#" class="link-olvido">¿Olvidaste tu contraseña?</a>
                </form>

                <div class="row g-3 mt-5">
                    <div class="col-6">
                        <button type="button" class="btn-social facebook"><i class="bi bi-facebook"></i></button>
                    </div>
                    <div class="col-6">
                        <button type="button" class="btn-social apple"><i class="bi bi-apple"></i></button>
                    </div>
                </div>
                
                <div class="text-center mt-4">
                     <p class="mb-0"><span class="text-muted small">¿No tienes cuenta?</span> <a asp-controller="Account" asp-action="Register" class="text-danger fw-bold ms-1 text-decoration-none small">Regístrate aquí</a></p>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Lógica para alternar el tipo de input entre 'password' (puntos) y 'text' (texto legible)
        document.getElementById('togglePass').addEventListener('click', function (e) {
            const passInput = document.getElementById('passInput');
            if (passInput.type === 'password') {
                passInput.type = 'text';
                this.classList.remove('bi-eye-slash');
                this.classList.add('bi-eye');
            } else {
                passInput.type = 'password';
                this.classList.remove('bi-eye');
                this.classList.add('bi-eye-slash');
            }
        });

        // REGLA: Bloqueo de repetición masiva de teclas (Ej. aaaaaaaaaaaaaaa...)
        document.getElementById('emailInput').addEventListener('input', function(e) {
            const val = e.target.value;
            const regexRepetidas = /(.)\1{14,}/; // Busca la misma letra repetida 15 veces consecutivas
            const errorBox = document.getElementById('errorBox');
            
            if(regexRepetidas.test(val)) {
                e.target.value = ""; // Vaciamos el campo inmediatamente
                errorBox.innerHTML = '<i class="bi bi-x-circle-fill me-2 text-danger"></i>No puedes repetir la misma letra tantas veces.';
                errorBox.classList.remove('d-none'); // Mostramos el mensaje de error
            } else {
                // Opcional: Oculta el error si el usuario empieza a escribir bien de nuevo (y no hay error de backend)
                if(!'@(ViewBag.Error != null ? "true" : "false")' === 'true') {
                    errorBox.classList.add('d-none');
                }
            }
        });
    </script>
</body>
</html>